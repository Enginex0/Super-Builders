# KSU Colonel NUKI - KernelSU-Next + SUSFS + ZeroMount + KPM EUD
# Core kernel config for SM6450 parrot

# Build
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y

# KSU
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SIMPLIFIED=y
CONFIG_KSU_SUSFS_OPENAT2=y
CONFIG_KSU_SUSFS_GETDENTS=y
CONFIG_KSU_SUSFS_STAT=y
CONFIG_KSU_SUSFS_TRIM_MOUNT=y

# ZeroMount
CONFIG_ZEROMOUNT=y
CONFIG_SYSFS_OVERLAY=y

# KPM EUD (Colonel)
CONFIG_KPM_EUD=y
CONFIG_EUD=y

# NetHunter
CONFIG_NETHunter=y
CONFIG_NETHunter_BOOST=y

# Compression
CONFIG_KERNEL_LZ4=y
CONFIG_RD_LZ4=y
CONFIG_INITRAMFS_COMPRESSION_LZ4=y

# ARM64
CONFIG_ARM64=y
CONFIG_ARCH_MSM=y
CONFIG_ARCH_SDM660=n
