static bool invalid_uid(uid_t uid,char *key,void *data) { return false; }
static void reset(void) {
    has_profile=ksu_boot_completed=ksu_webview_zygote_umount_enabled=false;
    refs=saves=writes=allocation_error=write_error=frees=0;
    manager_uid=12345; default_non_root_profile.umount_modules=true;
    stored=(struct app_profile){.version=KSU_APP_PROFILE_VER,.curr_uid=WEBVIEW_ZYGOTE_UID};
    memcpy(stored.key,"webview_zygote",sizeof("webview_zygote"));
    nosu=umounted=next_umounted=pending=root_allowed=false;
    namespace_kind=1; schedules=mount_calls=normal_fds=manager_marks=0;
    ksu_kernel_umount_enabled=ksu_module_mounted=true;
    entries[0].profile.curr_uid=WEBVIEW_ZYGOTE_UID;
    entries[1].profile.curr_uid=KSU_APP_PROFILE_PRESERVE_UID;
    entries[2].profile.curr_uid=10055;
    allow_list_count=3;pruned=0;
}
int test_main(void) {
    checks=0;reset();
    CHECK(profile_valid(&stored));
    stored.allow_su=true;memcpy(stored.rp_config.profile.selinux_domain,"u:r:su:s0",sizeof("u:r:su:s0"));CHECK(!profile_valid(&stored));
    stored.allow_su=false;stored.key[0]='x';CHECK(!profile_valid(&stored));
    reset();has_profile=true;stored.nrp_config.use_default=false;stored.nrp_config.profile.umount_modules=true;
    CHECK(ksu_uid_should_umount(1053));
    namespace_kind=2;CHECK(handle_zygote_next_setresuid(1053)==0);CHECK(nosu && umounted && next_umounted);
    CHECK(schedules==1);CHECK(refs==0);
    reset();has_profile=true;stored.nrp_config.use_default=false;stored.nrp_config.profile.umount_modules=false;
    CHECK(!ksu_uid_should_umount(1053));namespace_kind=2;CHECK(handle_zygote_next_setresuid(1053)==0);
    CHECK(nosu && !umounted && !next_umounted && schedules==0);CHECK(refs==0);
    reset();ksu_prune_allowlist(invalid_uid,NULL);CHECK(pruned==0);
    ksu_boot_completed=true;ksu_prune_allowlist(invalid_uid,NULL);CHECK(pruned==1 && allow_list_count==2);
    return 0;
}
int test_count(void) { return checks; }
#ifndef WASM_TEST
int printf(const char *,...);
int main(void) { int line=test_main();printf("WebView exact-C checks: %d; failure line: %d\n",checks,line);return line?1:0; }
#endif
