+    profile->version = KSU_APP_PROFILE_VER;
+    profile->curr_uid = WEBVIEW_ZYGOTE_UID;
+    memcpy(profile->key, "webview_zygote", sizeof("webview_zygote"));
+    profile->nrp_config.use_default = false;
+    profile->nrp_config.profile.umount_modules = enabled;
+    ret = ksu_set_app_profile(profile);
+    kfree(profile);
+    if (ret)
+        return ret;
+    ksu_persistent_allow_list();
+#endif
+    WRITE_ONCE(ksu_webview_zygote_umount_enabled, enabled);
