+int ksu_set_webview_zygote_umount(bool enabled)
+{
+    /* Allowlist loading runs asynchronously in init. Boot-time replay must
+     * never save a partial list or overwrite a profile that is still loading.
+     * Keep only the legacy fallback until boot is complete. */
+    if (!READ_ONCE(ksu_boot_completed)) {
+        WRITE_ONCE(ksu_webview_zygote_umount_enabled, enabled);
+        return 0;
+    }
+#ifndef CONFIG_KSU_DISABLE_POLICY
+    struct app_profile *profile;
