# [base]
CONFIG_KSU=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_LOCALVERSION_AUTO=n
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_PIE=y
CONFIG_NET_SCH_FQ_PIE=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BIC=n
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=65534
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NTSYNC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_XZ_DEC=y
CONFIG_XZ_DEC_MICROLZMA=y

# [susfs]
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_KSTAT_REDIRECT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_UNICODE_FILTER=y
CONFIG_KSU_SUSFS_HIDDEN_NAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# [susfs_uid_gated_hiding]
CONFIG_KSU_SUSFS_UID_GATED_HIDING=y

# [zeromount]
CONFIG_ZEROMOUNT=y

# [droidspaces]
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
# CONFIG_CGROUP_PIDS is not set
CONFIG_ANDROID_BINDERFS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# [zram]
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_STATS=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_842=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
CONFIG_ZRAM_DEF_COMP_LZ4KD=y

# [overlayfs]
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# [daily]
# KASAN, KFENCE and UBSAN stay out of the daily kernel. The Android 14/6.1
# kasan_flag_enabled KMI is retained by an always-built inactive static-key
# stub. CFI and Shadow Call Stack remain enabled and are audited.
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
# Keep a 4 MiB kernel printk ring buffer. The matching AnyKernel parameter
# remains visible as log_buf_len=4M for post-boot ADB verification.
CONFIG_LOG_BUF_SHIFT=22
# CONFIG_KFENCE is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KASAN_SW_TAGS is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_UBSAN_BOUNDS is not set
# CONFIG_UBSAN_LOCAL_BOUNDS is not set

# [performance]
# Disable kernel debug features if enabled in base MTK config.
# These are NOT in gki_defconfig — may be set by vendor config.
# Check /proc/config.gz on device before uncommenting.
# CONFIG_DEBUG_MUTEXES is not set                    # [CHECK DEVICE FIRST]
# CONFIG_DEBUG_SPINLOCK is not set                   # [CHECK DEVICE FIRST]
# CONFIG_DEBUG_ATOMIC_SLEEP is not set               # [CHECK DEVICE FIRST]
# CONFIG_PROVE_LOCKING is not set                    # [CHECK DEVICE FIRST]
# CONFIG_LOCKDEP is not set                          # [CHECK DEVICE FIRST]
# CONFIG_DEBUG_LOCK_ALLOC is not set                 # [CHECK DEVICE FIRST]

# [kpm]
CONFIG_KPM=y
