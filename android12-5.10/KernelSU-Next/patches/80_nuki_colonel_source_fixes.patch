-		ret = -ETIMEDOUT;
-
-err_clear_bit:
-	clear_bit(DEV_CMD_PENDING, &uc->flags);
-	pm_runtime_put_sync(uc->dev);
-	mutex_unlock(&uc->lock);
-
-	return ret;
-}
 
